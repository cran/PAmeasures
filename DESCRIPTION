Package: PAmeasures
Type: Package
Title: Performance Assessment for Continuous and Survival Outcomes
Version: 2.0.0
Date: 2026-10-27
Authors@R: c(
    person("Tong", "Zhu", role = "aut"),
    person("Zian", "Zhuang", email = "zianzhuang@ucla.edu", role = c("aut", "cre")),
    person("Wen", "Su", role = "aut"),
